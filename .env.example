# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the browser. Used by invite/seed/create-owner scripts
# and the invite Route Handler.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used only as a guard so `npm run seed` refuses to run against a real project.
# Set this to your local/dev project ref to allow seeding it.
NEXT_PUBLIC_SUPABASE_SEED_ALLOW=

# Used by create-owner script
FIRST_OWNER_EMAIL=owner@example.com
FIRST_OWNER_PASSWORD=changeme123!
FIRST_OWNER_NAME="Owner Name"
